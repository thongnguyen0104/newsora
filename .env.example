# --- Database (SQLite) ---
# Local: file SQLite trong thư mục dự án
DATABASE_URL=file:./newsora.db
# Production trên Vercel: dùng Turso (SQLite trên cloud), ví dụ libsql://newsora-<user>.turso.io
DATABASE_AUTH_TOKEN=

# Chuỗi bí mật ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Lưu ảnh trên Oracle Cloud Object Storage (S3 Compatibility API) ---
# Để trống S3_BUCKET khi dev local: ảnh lưu vào thư mục /media
S3_BUCKET=
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=
# Ví dụ: ap-singapore-1
S3_REGION=
# Tạo tại: Profile → Customer secret keys
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# (Tuỳ chọn) Nếu bucket Public: https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
S3_PUBLIC_URL=
